<Application x:Class="OrthoSpineAI.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OrthoSpineAI.UI.ViewModels"
             xmlns:views="clr-namespace:OrthoSpineAI.UI.Views"
             xmlns:conv="clr-namespace:OrthoSpineAI.UI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Converters -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <conv:IsEqualMultiConverter x:Key="IsEqualMultiConverter"/>

            <!-- Drop shadow used on cards -->
            <DropShadowEffect x:Key="CardShadow" BlurRadius="12" ShadowDepth="2"
                              Opacity="0.15" Color="#000000"/>

            <!-- Map each ViewModel to its View via implicit DataTemplates -->
            <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                <views:LoginView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PatientListViewModel}">
                <views:PatientListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PatientDetailViewModel}">
                <views:PatientDetailView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AddPatientViewModel}">
                <views:AddPatientView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:EditPatientViewModel}">
                <views:EditPatientView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SurveySelectionViewModel}">
                <views:SurveySelectionView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PreTestViewModel}">
                <views:PreTestView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SurveyRunViewModel}">
                <views:SurveyRunView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AwwsResultViewModel}">
                <views:AwwsResultView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

