<UserControl x:Class="OrthoSpineAI.UI.Views.SurveyRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT PANEL ═══ -->
        <Grid Grid.Column="0" Margin="24,20,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- survey title + progress -->
                <RowDefinition Height="Auto"/>   <!-- stage card -->
                <RowDefinition Height="Auto"/>   <!-- measure capture -->
                <RowDefinition Height="*"/>      <!-- captured history -->
                <RowDefinition Height="Auto"/>   <!-- navigation buttons -->
            </Grid.RowDefinitions>

            <!-- Survey title + progress bar -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding ProgressText}"
                               FontSize="12" Foreground="#757575" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Definition.Name, Mode=OneWay}"
                               FontSize="18" FontWeight="Bold" Foreground="#1565C0"/>
                </DockPanel>
                <ProgressBar Value="{Binding StageNumber}"
                             Maximum="{Binding TotalStages}"
                             Height="6" Margin="0,6,0,0"
                             Background="#E3F2FD" Foreground="#1565C0"/>
            </StackPanel>

            <!-- Stage instruction card -->
            <Border Grid.Row="1" Background="White" BorderBrush="#90CAF9" BorderThickness="1"
                    CornerRadius="6" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding CurrentStage.Name}"
                               FontSize="16" FontWeight="SemiBold" Foreground="#1565C0" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding CurrentStage.Tip}"
                               FontSize="13" Foreground="#424242"
                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding CurrentStage.TipControl}"
                               FontSize="12" Foreground="#757575"
                               TextWrapping="Wrap" FontStyle="Italic"/>
                </StackPanel>
            </Border>

            <!-- Measurement capture -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="6" Padding="16" Margin="0,0,0,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0" Width="160">
                        <Button Content="📌 Zapisz pomiar"
                                Command="{Binding CaptureValueCommand}"
                                Padding="0,10" Background="#E3F2FD" Foreground="#1565C0"
                                BorderThickness="0" FontSize="13" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12" Foreground="#2E7D32"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Aktualny kąt (Roll)" FontSize="11" Foreground="#757575"/>
                        <TextBlock FontSize="46" FontWeight="Bold" Foreground="#1565C0">
                            <Run Text="{Binding Roll, StringFormat={}{0:F1}, Mode=OneWay}"/>
                            <Run Text="°"/>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="#9E9E9E">
                            <Run Text="Zapisano: "/>
                            <Run Text="{Binding CapturedValue, StringFormat={}{0:F1}, Mode=OneWay}"/>
                            <Run Text="°"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Captured stages history -->
            <Border Grid.Row="3" Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="6" Padding="12" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Zapisane pomiary" FontSize="12" FontWeight="SemiBold"
                               Foreground="#757575" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding CapturedStages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock DockPanel.Dock="Right"
                                               FontSize="13" FontWeight="Bold" Foreground="#1565C0">
                                        <Run Text="{Binding Value, StringFormat={}{0:F1}, Mode=OneWay}"/>
                                        <Run Text="°"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="#424242" VerticalAlignment="Center">
                                        <Run Text="{Binding StageNumber, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=". "/>
                                        <Run Text="{Binding StageName, Mode=OneWay}"/>
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Brak zapisanych pomiarów." FontSize="12"
                               Foreground="#BDBDBD" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CapturedStages.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Navigation buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="← Poprzedni" Command="{Binding PreviousStepCommand}"
                        Padding="16,9" Margin="0,0,8,0"
                        Background="#E0E0E0" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="✕ Anuluj" Command="{Binding CancelSurveyCommand}"
                        Padding="16,9" Margin="0,0,8,0"
                        Background="#FFEBEE" Foreground="#C62828"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <!-- Dynamic last/next button -->
                <Button Command="{Binding NextStepCommand}"
                        Padding="20,9" BorderThickness="0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="Następny →"/>
                            <Setter Property="Background" Value="#1565C0"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLastStage}" Value="True">
                                    <Setter Property="Content" Value="✓ Zakończ badanie"/>
                                    <Setter Property="Background" Value="#2E7D32"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFinalizing}" Value="True">
                                    <Setter Property="Content" Value="Obliczanie…"/>
                                    <Setter Property="Background" Value="#757575"/>
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══ RIGHT PANEL — live device telemetry ═══ -->
        <Border Grid.Column="2" Margin="0,20,20,20" Background="White"
                BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="16">
            <StackPanel>
                <!-- Device status header -->
                <DockPanel Margin="0,0,0,4">
                    <Ellipse DockPanel.Dock="Right" Width="10" Height="10"
                             VerticalAlignment="Center" Margin="6,0,0,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#F44336"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#4CAF50"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="Urządzenie ORT-100" FontSize="14" FontWeight="Bold"/>
                </DockPanel>
                <TextBlock Text="{Binding DeviceStatus}" FontSize="11"
                           Foreground="#757575" Margin="0,0,0,20"/>

                <!-- Roll -->
                <TextBlock Text="Kąt Roll" FontSize="11" Foreground="#9E9E9E"/>
                <TextBlock FontSize="32" FontWeight="Bold" Foreground="#1565C0" Margin="0,2,0,16">
                    <Run Text="{Binding Roll, StringFormat={}{0:F1}, Mode=OneWay}"/>
                    <Run Text="°"/>
                </TextBlock>

                <!-- Tilt -->
                <TextBlock Text="Przechył Tilt" FontSize="11" Foreground="#9E9E9E"/>
                <TextBlock FontSize="22" Foreground="#424242" Margin="0,2,0,16">
                    <Run Text="{Binding Tilt, StringFormat={}{0:F1}, Mode=OneWay}"/>
                    <Run Text="°"/>
                </TextBlock>

                <!-- Way -->
                <TextBlock Text="Dystans Way" FontSize="11" Foreground="#9E9E9E"/>
                <TextBlock FontSize="22" Foreground="#424242" Margin="0,2,0,16">
                    <Run Text="{Binding Way, Mode=OneWay}"/>
                    <Run Text=" mm"/>
                </TextBlock>

                <!-- Battery -->
                <TextBlock Text="Bateria" FontSize="11" Foreground="#9E9E9E"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,16" VerticalAlignment="Center">
                    <TextBlock FontSize="16" Foreground="#424242">
                        <Run Text="{Binding Battery, StringFormat={}{0:F2}, Mode=OneWay}"/>
                        <Run Text=" V"/>
                    </TextBlock>
                </StackPanel>

                <Separator Margin="0,0,0,16"/>

                <!-- Patient info -->
                <TextBlock Text="Pacjent" FontSize="11" Foreground="#9E9E9E"/>
                <TextBlock Text="{Binding Patient.FullName}" FontSize="13"
                           FontWeight="SemiBold" Foreground="#424242" Margin="0,2,0,4"
                           TextWrapping="Wrap"/>
                <TextBlock FontSize="11" Foreground="#757575">
                    <Run Text="Wiek: "/>
                    <Run Text="{Binding Patient.AgeYears, Mode=OneWay}"/>
                    <Run Text=" lat"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

