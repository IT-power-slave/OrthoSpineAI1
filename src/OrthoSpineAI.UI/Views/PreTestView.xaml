<UserControl x:Class="OrthoSpineAI.UI.Views.PreTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid Background="#F5F5F5">
        <Border Width="480" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="White" CornerRadius="8"
                Effect="{StaticResource CardShadow}" Padding="32">
            <StackPanel>
                <!-- Header -->
                <TextBlock Text="Dane przed badaniem" FontSize="20" FontWeight="Bold"
                           Foreground="#1565C0" Margin="0,0,0,4"/>
                <TextBlock FontSize="13" Foreground="#757575" Margin="0,0,0,4">
                    <Run Text="Pacjent: "/>
                    <Run Text="{Binding Patient.FullName, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock FontSize="13" Foreground="#757575" Margin="0,0,0,20">
                    <Run Text="Badanie: "/>
                    <Run Text="{Binding Definition.Name, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>

                <!-- Weight -->
                <TextBlock Text="Masa ciała (kg)" FontSize="12" Foreground="#424242" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" Padding="8,6" Margin="0,0,0,12"
                         BorderBrush="#BDBDBD" BorderThickness="1"/>

                <!-- Height -->
                <TextBlock Text="Wzrost (cm)" FontSize="12" Foreground="#424242" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Growth, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" Padding="8,6" Margin="0,0,0,12"
                         BorderBrush="#BDBDBD" BorderThickness="1"/>

                <!-- Beighton -->
                <TextBlock Text="Skala Beightona (0–9)" FontSize="12" Foreground="#424242" Margin="0,0,0,4"/>
                <Slider Minimum="0" Maximum="9" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding Beighton}" Margin="0,0,0,4"/>
                <TextBlock FontSize="13" Foreground="#1565C0" Margin="0,0,0,12">
                    <Run Text="Wartość: "/>
                    <Run Text="{Binding Beighton, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>

                <!-- Hump Score -->
                <TextBlock Text="Hump Score — HS (0–20)" FontSize="12" Foreground="#424242" Margin="0,0,0,4"/>
                <Slider Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding Hs}" Margin="0,0,0,4"/>
                <TextBlock FontSize="13" Foreground="#1565C0" Margin="0,0,0,12">
                    <Run Text="Wartość: "/>
                    <Run Text="{Binding Hs, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>

                <!-- BMI Card -->
                <Border Background="#E3F2FD" CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Wskaźnik BMI" FontSize="11" Foreground="#1565C0"/>
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="#0D47A1">
                                <Run Text="{Binding BmiText, Mode=OneWay}"/>
                                <Run Text=" kg/m²" FontSize="13" Foreground="#1565C0"/>
                            </TextBlock>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#1565C0" CornerRadius="4"
                                Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BmiCategory, Mode=OneWay}"
                                       Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Flags -->
                <TextBlock Text="Parametry kliniczne" FontSize="12" Foreground="#757575"
                           Margin="0,0,0,8"/>
                <CheckBox Content="Test przeprostu palucha (TestPP)"
                          IsChecked="{Binding TestPP}" Margin="0,0,0,6" FontSize="13"/>
                <CheckBox Content="Koślawość kolan (Knee Valgus)"
                          IsChecked="{Binding KneeValgus}" Margin="0,0,0,6" FontSize="13"/>
                <CheckBox Content="Koślawość stóp (Tarsal Valgus)"
                          IsChecked="{Binding TarsalValgus}" Margin="0,0,0,6" FontSize="13"/>
                <CheckBox Content="Zaburzenia chodu (Gait Disturbance)"
                          IsChecked="{Binding GaitDisturbance}" Margin="0,0,0,16" FontSize="13"/>

                <!-- Notes -->
                <TextBlock Text="Notatki kliniczne (opcjonalne)" FontSize="12" Foreground="#757575"
                           Margin="0,0,0,4"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="64"
                         Padding="6" FontSize="13" VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,16"/>

                <!-- Validation -->
                <TextBlock Text="{Binding ValidationMessage}" Foreground="#C62828"
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding ValidationMessage,
                               Converter={StaticResource StringToVisibilityConverter}}"/>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Anuluj" Command="{Binding CancelCommand}"
                            Padding="20,8" Margin="0,0,12,0"
                            Background="#E0E0E0" BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Rozpocznij badanie →" Command="{Binding ConfirmCommand}"
                            Padding="20,8" Background="#1565C0" Foreground="White"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
