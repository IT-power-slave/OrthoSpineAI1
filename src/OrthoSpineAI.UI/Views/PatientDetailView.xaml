<UserControl x:Class="OrthoSpineAI.UI.Views.PatientDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header card -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                CornerRadius="6" Padding="20" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="✏ Edytuj" Command="{Binding EditCommand}"
                            Padding="14,7" Margin="0,0,8,0"
                            Background="#E3F2FD" Foreground="#1565C0"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="🗑 Usuń pacjenta" Command="{Binding DeleteCommand}"
                            Padding="14,7" Margin="0,0,8,0"
                            Background="#FFEBEE" Foreground="#C62828"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="▶ Nowe badanie" Command="{Binding NewSurveyCommand}"
                            Padding="14,7" Background="#1565C0" Foreground="White"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <StackPanel>
                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="#1565C0">
                        <Run Text="{Binding Patient.FirstName, Mode=OneWay}"/>
                        <Run Text="{Binding Patient.LastName, Mode=OneWay}"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="PESEL: " FontSize="12" Foreground="#757575"/>
                        <TextBlock Text="{Binding Patient.PESEL, Mode=OneWay}" FontSize="12" Foreground="#424242" Margin="0,0,16,0"/>
                        <TextBlock Text="Wiek: " FontSize="12" Foreground="#757575"/>
                        <TextBlock Text="{Binding Patient.AgeYears, Mode=OneWay}" FontSize="12" Foreground="#424242" Margin="0,0,4,0"/>
                        <TextBlock Text="lat" FontSize="12" Foreground="#757575" Margin="0,0,16,0"/>
                        <TextBlock Text="Płeć: " FontSize="12" Foreground="#757575"/>
                        <TextBlock Text="{Binding Patient.Sex, Mode=OneWay}" FontSize="12" Foreground="#424242" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding Patient.AddressCity, Mode=OneWay}" FontSize="12" Foreground="#757575"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Section title -->
        <TextBlock Grid.Row="1" Text="Historia badań" FontSize="15" FontWeight="SemiBold"
                   Foreground="#424242" Margin="0,0,0,8"/>

        <!-- Test history list -->
        <Grid Grid.Row="2">
            <TextBlock Text="Brak wykonanych badań." FontSize="13" Foreground="#9E9E9E"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TestHistory.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <DataGrid ItemsSource="{Binding TestHistory}"
                      SelectedItem="{Binding SelectedTest}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      SelectionMode="Single" CanUserReorderColumns="False"
                      CanUserResizeRows="False" RowHeight="36"
                      BorderThickness="1" BorderBrush="#E0E0E0" Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data" Width="160"
                        Binding="{Binding ExaminationDate, StringFormat=\{0:dd.MM.yyyy HH:mm\}}"/>
                    <DataGridTextColumn Header="Typ badania" Width="*"
                        Binding="{Binding MedTestDefinitionKey}"/>
                    <DataGridTextColumn Header="Masa (kg)" Width="90"
                        Binding="{Binding Weight, StringFormat={}{0:F1}}"/>
                    <DataGridTextColumn Header="Wzrost (cm)" Width="90"
                        Binding="{Binding Growth, StringFormat={}{0:F1}}"/>
                    <DataGridTextColumn Header="Beighton" Width="70"
                        Binding="{Binding Beighton}"/>
                </DataGrid.Columns>
            </DataGrid>

            <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <Button Content="← Wróć do listy pacjentów"
                    Command="{Binding BackCommand}"
                    HorizontalAlignment="Left"
                    Padding="20,8" Background="#E0E0E0"
                    BorderThickness="0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="📋 Pokaż wynik wybranego badania"
                    Command="{Binding ViewResultCommand}"
                    HorizontalAlignment="Right"
                    Padding="20,8" Background="#1565C0" Foreground="White"
                    BorderThickness="0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                            Padding="{TemplateBinding Padding}" Opacity="{TemplateBinding Opacity}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DockPanel>
    </Grid>
</UserControl>
