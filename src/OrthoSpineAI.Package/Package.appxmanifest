<?xml version="1.0" encoding="utf-8"?>
<!--
  Package.appxmanifest — MSIX Application Manifest for OrthoSpineAI

  KEY FIELDS TO KEEP SYNCHRONIZED:
    Identity Version  ←→  PackageVersion in .wapproj  ←→  <Version> in UI.csproj
    Identity Publisher  ←→  Subject of signing certificate
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap mp rescap">

  <Identity
    Name="OrthoSpineAI"
    Publisher="CN=OrthoSpineAI"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <mp:PhoneIdentity
    PhoneProductId="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
    PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>OrthoSpine AI</DisplayName>
    <PublisherDisplayName>OrthoSpineAI</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application
      Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">

      <uap:VisualElements
        DisplayName="OrthoSpine AI"
        Description="AI-assisted orthopaedic and spine management system."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- Register as startup application (optional) -->
        <!--
        <uap:Extension Category="windows.startupTask">
          <uap:StartupTask TaskId="OrthoSpineAIStartup" Enabled="false" DisplayName="OrthoSpine AI" />
        </uap:Extension>
        -->
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Full trust required for WPF / .NET desktop apps -->
    <rescap:Capability Name="runFullTrust" />
    <!-- Add further capabilities only as required, e.g.:
    <Capability Name="internetClient" />
    <uap:Capability Name="userAccountInformation" />
    -->
  </Capabilities>

</Package>
